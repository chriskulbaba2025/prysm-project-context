# Copy to repository root as P#_EXECUTION_GATE.env only after the required evidence is committed and verified.
# Example: P1_EXECUTION_GATE.env
# Do not create a PASS-looking gate speculatively.

P_ID=P1
AUTHORIZED_STAGE=DIAGNOSTIC_TRUTH
APPLICATION_BRANCH=main
APPLICATION_SHA=<exact-application-sha>

# Required before DIAGNOSTIC_TRUTH
CONTRACT_FILE=P1_OUTCOME_CONTRACT_YYYY-MM-DD.md
CONTRACT_COMMIT=<governance-commit>
BRAD_REVIEW_FILE=P1_BRAD_DISPOSITION_REVIEW_YYYY-MM-DD_HHMMSS.md
BRAD_REVIEW_COMMIT=<governance-commit>
BRAD_VERDICT=PASS
APPROVAL_FILE=P1_APPROVAL_ATTESTATION_YYYY-MM-DD.md
APPROVAL_COMMIT=<governance-commit>
CHRIS_APPROVAL=APPROVED
PRE_EXECUTION_AUDIT_FILE=P1_PRE_EXECUTION_PROCESS_AUDIT_YYYY-MM-DD_HHMMSS.md
PRE_EXECUTION_AUDIT_COMMIT=<governance-commit>
PRE_EXECUTION_AUDIT_VERDICT=PASS

# Required before BOUNDED_BUILD
# DIAGNOSTIC_FILE=
# DIAGNOSTIC_COMMIT=
# DIAGNOSTIC_CLASSIFICATION=VERIFIED_ROOT_CAUSE|VERIFIED_DESIGN_GAP
# BETTY_PRE_REPAIR_FILE=
# BETTY_PRE_REPAIR_COMMIT=
# BETTY_PRE_REPAIR_VERDICT=PASS
# REPAIR_AUTH_FILE=
# REPAIR_AUTH_COMMIT=
# CHRIS_REPAIR_AUTH=APPROVED

# Required before OUTCOME_REVIEW
# TECHNICAL_PROOF_FILE=
# TECHNICAL_PROOF_COMMIT=
# SYSTEM_PROOF_FILE=
# SYSTEM_PROOF_COMMIT=
# CANDIDATE_FREEZE_FILE=
# CANDIDATE_FREEZE_COMMIT=
# PRODUCT_PROOF_FILE=
# PRODUCT_PROOF_COMMIT=

# Required before CLOSURE
# BRAD_OUTCOME_FILE=
# BRAD_OUTCOME_COMMIT=
# BRAD_OUTCOME_VERDICT=PASS
# BETTY_FINAL_FILE=
# BETTY_FINAL_COMMIT=
# BETTY_FINAL_VERDICT=PASS
# CLOSURE_AUTH_FILE=
# CLOSURE_AUTH_COMMIT=
# CHRIS_CLOSURE=APPROVE_AND_ADVANCE
