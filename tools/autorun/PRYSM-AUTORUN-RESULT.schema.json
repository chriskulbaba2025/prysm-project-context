{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "loop_action": {"type": "string", "enum": ["CONTINUE", "STOP", "BLOCKED", "COMPLETE"]},
    "role": {"type": "string", "enum": ["Builder", "Auditor"]},
    "next_role": {"type": "string", "enum": ["Builder", "Auditor", "NONE"]},
    "tranche": {"type": "string"},
    "checkpoint": {"type": "string"},
    "reason": {"type": "string"},
    "application_branch": {"type": "string"},
    "application_sha": {"type": "string"},
    "governance_sha": {"type": "string"},
    "whole_app_gate": {"type": "string", "enum": ["PASS", "FAIL", "NOT_RUN", "NOT_APPLICABLE"]},
    "material_defects": {"type": "integer", "minimum": 0},
    "repair_attempt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3,
      "description": "Echo of the controller-provided current repair index. The controller, not Codex, computes the next repair level."
    },
    "root_defect_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "description": "Stable identity of the active root-defect boundary. Use NONE when no repair defect is active."
    },
    "failure_class": {
      "type": "string",
      "enum": ["NONE", "REPAIR_PROOF_FAILED", "NEW_ROOT_CAUSE", "PROOF_SETUP_FAILURE", "EXTERNAL_OR_PROTOCOL"],
      "description": "Classification used by controller-owned repair accounting. PROOF_SETUP_FAILURE means the intended governed assertion was not reached because the proof harness/setup itself failed; it does not consume a repair escalation level."
    },
    "next_action": {"type": "string"},
    "github_state_synced": {"type": "boolean"}
  },
  "required": [
    "loop_action",
    "role",
    "next_role",
    "tranche",
    "checkpoint",
    "reason",
    "application_branch",
    "application_sha",
    "governance_sha",
    "whole_app_gate",
    "material_defects",
    "repair_attempt",
    "root_defect_id",
    "failure_class",
    "next_action",
    "github_state_synced"
  ]
}
